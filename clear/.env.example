# Mock mode is safe for the hackathon demo. Real values require confirmed vendor documentation.
NEXT_PUBLIC_INTEGRATION_MODE=mock
NEXT_PUBLIC_SCOREPLAY_BASE_URL=
NEXT_PUBLIC_TWELVELABS_BASE_URL=

# Keep real credentials server-only; never prefix secrets with NEXT_PUBLIC_.
SCOREPLAY_API_KEY=
TWELVELABS_API_KEY=

# Supabase project values. The service role key must stay server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
