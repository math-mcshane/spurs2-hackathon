# Copy to .env.local (gitignored). Never commit real keys or event media.

# ScorePlay (system of record) — https://developer.scoreplay.io/
SCOREPLAY_API_KEY=
SCOREPLAY_API_BASE_URL=

# TwelveLabs — shared pre-indexed index; videos carry custom_id = ScorePlay asset id
TWELVELABS_API_KEY=
TWELVELABS_INDEX_ID=

# Policy dataset (JSON under src/lib/rights/policies/). Fictional demo policy by default.
REROUTE_POLICY_ID=demo-spurs-fr-sponsored

# Set to "true" ONLY after organizers confirm media may be processed off-platform (FFmpeg render, spec §9).
MEDIA_PROCESSING_APPROVED=false

# Set to "true" only after ScorePlay staff confirm derivative upload permission.
SCOREPLAY_UPLOAD_APPROVED=false
