# Copy to .env.local (gitignored). Never commit real keys or event media.

# ScorePlay (system of record) — https://developer.scoreplay.io/
SCOREPLAY_API_KEY=
SCOREPLAY_API_BASE_URL=

# TwelveLabs — shared pre-indexed index; videos carry custom_id = ScorePlay asset id
TWELVELABS_API_KEY=
TWELVELABS_INDEX_ID=

# Supabase (receipts, reviews, HUMAN observations) — server-only secret key, never NEXT_PUBLIC_.
# Supabase → Project Settings → API keys. Schema: supabase/migrations/*.sql
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Reviewer sign-in (review, HUMAN observations, writeback, render). Both required; if either is missing,
# reviewer sign-in is disabled (those actions return NOT_CONFIGURED) — never open.
# Passcode shared with reviewers; secret signs the HttpOnly session cookie: `openssl rand -base64 48` (≥ 32 chars).
REROUTE_REVIEWER_PASSCODE=
REROUTE_SESSION_SECRET=

# Set to "true" ONLY after organizers confirm media may be processed off-platform (FFmpeg render, spec §9).
MEDIA_PROCESSING_APPROVED=false

# Set to "true" only after ScorePlay staff confirm derivative upload permission.
SCOREPLAY_UPLOAD_APPROVED=false

# PULSE (optional module). Missing/anything but "true" = disabled: /pulse and /api/pulse/* return 404.
PULSE_ENABLED=false
# fixture = labeled SIMULATED demo replay signals; manual = producer-entered triggers only.
PULSE_SIGNAL_SOURCE=fixture
# Authorized store/ticketing links for campaign CTAs: club:product:market=https://…;… (market may be *).
# Example: spurs:jersey:MX=https://store.example/mx;tottenham:tickets:*=https://tickets.example
PULSE_COMMERCE_DESTINATIONS=
# "off" hides in-app moment players (ScorePlay proxy / TwelveLabs stream references) if embedding is not permitted.
PULSE_VIDEO_PREVIEW=on
# Optional per-club TwelveLabs index for the campaign studio; empty = TWELVELABS_INDEX_ID.
PULSE_TWELVELABS_INDEX_ID_TOTTENHAM=
PULSE_TWELVELABS_INDEX_ID_SPURS=
