# Copy to .env.local (gitignored). Never commit real keys or event media.
# On Vercel set these as deploy-time / project environment variables instead.

# --- ScorePlay (system of record for media) — https://developer.scoreplay.io/
SCOREPLAY_API_KEY=
# Optional; empty = the documented default API base URL.
SCOREPLAY_API_BASE_URL=
# dry-run (default) = writeback only plans actions. live = writes tags/logs, and only for a non-fictional
# policy with a final human review. Keep dry-run: live needs organizer authorization.
SCOREPLAY_WRITEBACK_MODE=dry-run
# "true" ONLY after ScorePlay staff confirm derivative upload permission.
SCOREPLAY_UPLOAD_APPROVED=false

# --- TwelveLabs (Marengo search, Pegasus analysis). Legacy alias TWELVE_LABS_API_KEY is also read.
TWELVELABS_API_KEY=
# Shared index (hackathon: "premiere-league", 58 Tottenham v Man Utd videos).
TWELVELABS_INDEX_ID=
# Optional per-club index override (PULSE_TWELVELABS_INDEX_ID_<CLUB>); empty = TWELVELABS_INDEX_ID.
# Optional per-club key for an index in another TwelveLabs account (PULSE_TWELVELABS_API_KEY_<CLUB>);
# falls back to TWELVELABS_API_KEY, then TWELVE_LABS_API_KEY. Pair with the matching index id.
PULSE_TWELVELABS_INDEX_ID_TOTTENHAM=
PULSE_TWELVELABS_INDEX_ID_SPURS=
PULSE_TWELVELABS_API_KEY_SPURS=

# "true" = every TwelveLabs + ScorePlay READ is served from committed real recordings in demo-cache/
# (labeled CACHED with recordedAt; a missing recording is an error, nothing synthesized; no previews).
# Unset/false = live, with per-call fallback to a recording on network error / HTTP 429 / 5xx.
# Record with scripts/record-demo-cache.ts.
DEMO_REPLAY=false
# Tests only: overrides the recording directory (default demo-cache/).
# DEMO_CACHE_DIR=

# --- Supabase (goal runs, campaigns, evaluations, receipts, reviews, audit events). Server-only secret key,
# never NEXT_PUBLIC_. Local: `supabase start` → http://127.0.0.1:54321 + its secret key.
# NEXT_PUBLIC_SUPABASE_URL is read only as a fallback for SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Reviewer sign-in (review, writeback, HUMAN observations, render). Both required, else sign-in is
# disabled (NOT_CONFIGURED) — never open. Named reviewers, each with a personal passcode; only scrypt hashes
# live here. Generate (passcodes go ONLY to the gitignored .reviewers.local.txt, mode 600):
#   pnpm exec tsx scripts/reviewer-credentials.ts ed="Ed Smith" jo="Jo Lee"
# Format: id:displayName:scryptHash:salt;… or a JSON array of {id, displayName, scryptHash, salt}. Re-issuing a
# reviewer rotates their hash and ends their sessions. Their configured displayName is the recorded identity.
REROUTE_REVIEWERS=
# Signs the HttpOnly session cookie (4 h, SameSite=Strict): `openssl rand -base64 48` (>= 32 chars).
REROUTE_SESSION_SECRET=
# API rate limits (per client IP, in memory per instance — best-effort on serverless; add a Vercel Firewall
# rule for a real cap) are fixed in src/lib/server/rate-limit.ts; no env needed.

# "true" ONLY after organizers confirm media may be processed off-platform (FFmpeg render).
MEDIA_PROCESSING_APPROVED=false

# --- PULSE Studio
# Footage-derived URLs (players, streams, thumbnails) in API responses: off unless exactly "true",
# and even then only for a signed-in reviewer. Keep off until the organizers confirm playback rights.
MEDIA_PREVIEW_ENABLED=false
# Authorized store/ticketing links for campaign CTAs: club:product:market=https://…;… (market may be *).
# Example: tottenham:jersey:GB=https://store.example/gb;tottenham:tickets:*=https://tickets.example
PULSE_COMMERCE_DESTINATIONS=
# Simulated fan-signal board at /pulse/board (+ its APIs). Only the exact string "true" enables it.
PULSE_BOARD_ENABLED=false
# Board only: fixture (labeled SIMULATED demo replay) | manual (producer-entered triggers only).
PULSE_SIGNAL_SOURCE=fixture

# --- Tests only: LIVE_SMOKE=1 runs the read-only live ScorePlay/TwelveLabs smoke tests.
# LIVE_SMOKE=
